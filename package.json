{
  "name": "filmclip",
  "productName": "FilmClip",
  "version": "1.0.0",
  "description": "A free, offline, no-login desktop video editor",
  "main": "src/main/main.js",
  "author": "FilmClip",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node test/run-tests.js",
    "icon": "python3 scripts/make-icon.py",
    "dist:mac": "electron-builder --mac dmg --publish never",
    "dist:mac:arm64": "electron-builder --mac dmg --arm64 --publish never",
    "dist:mac:x64": "electron-builder --mac dmg --x64 --publish never",
    "dist:linux": "electron-builder --linux AppImage --publish never"
  },
  "dependencies": {
    "ffmpeg-static": "5.3.0"
  },
  "devDependencies": {
    "electron": "44.3.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "app.filmclip.editor",
    "productName": "FilmClip",
    "copyright": "FilmClip — MIT License",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["src/**/*", "package.json"],
    "asarUnpack": ["node_modules/ffmpeg-static/**"],
    "fileAssociations": [
      { "ext": "fcproj", "name": "FilmClip Project", "role": "Editor" }
    ],
    "mac": {
      "category": "public.app-category.video",
      "icon": "build/icon.png",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "target": ["dmg"],
      "extendInfo": {
        "NSMicrophoneUsageDescription": "FilmClip does not record audio.",
        "NSCameraUsageDescription": "FilmClip does not use the camera."
      }
    },
    "dmg": {
      "title": "FilmClip ${version}",
      "artifactName": "FilmClip-${version}-${arch}.${ext}",
      "contents": [
        { "x": 130, "y": 220 },
        { "x": 410, "y": 220, "type": "link", "path": "/Applications" }
      ],
      "window": { "width": 540, "height": 380 }
    },
    "linux": { "target": ["AppImage"], "icon": "build/icon.png", "category": "Video" }
  }
}
